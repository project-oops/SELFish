#!/usr/bin/env bash
# selfish - the dev command for this repository.
#
#   ./bin/selfish build       release build of the workspace
#   ./bin/selfish test        the test suite
#   ./bin/selfish lint        clippy at -D warnings
#   ./bin/selfish fmt         format in place
#   ./bin/selfish check       everything CI's gate runs (the default)
#   ./bin/selfish clean       remove build output
#   ./bin/selfish doc         build the API docs
#   ./bin/selfish provenance  every format table names its sources, and no material is tracked
#   ./bin/selfish links       the linker tests ran rather than skipping for a missing lld
#
# `links` is not in `check`: it only matters on a machine that might lack the linker, and CI
# runs it as its own step. The library crates build from this repository alone; the CLI also
# needs oops-libs beside it.
#
# Output filtering never sits between a command and its exit status: filtered output goes to a
# file first.
set -euo pipefail
# shellcheck source=/dev/null
[ -f "$HOME/.cargo/env" ] && . "$HOME/.cargo/env"
export PATH="$HOME/.cargo/bin:$PATH"

cd "$(dirname "$0")/.."

DOC_FLAGS="-D rustdoc::broken_intra_doc_links -D rustdoc::invalid_html_tags -D rustdoc::bare_urls"

check() {
    log="${TMPDIR:-/tmp}/selfish-gate.$$"
    trap 'rm -f "$log"' EXIT

    printf '=== formatting\n'
    cargo fmt --all --check
    printf 'formatted\n'

    printf '=== lints\n'
    cargo clippy --all-targets --all-features -- -D warnings
    printf 'clean\n'

    printf '=== tests\n'
    cargo test --workspace >"$log" 2>&1 || { tail -30 "$log"; exit 1; }
    printf '%s passed\n' "$(grep -oE '[0-9]+ passed' "$log" | awk '{s+=$1} END {print s}')"

    printf '=== docs\n'
    RUSTDOCFLAGS="$DOC_FLAGS" cargo doc --no-deps --workspace -q >"$log" 2>&1 \
        || { tail -30 "$log"; exit 1; }
    printf 'documented\n'

    printf '\ngate passed\n'
}

# Real files are an oracle, never a source, so none is tracked. Content is checked as well as
# extension, because an executable need not have one.
provenance() {
    local status=0 table
    for table in data/*.tsv data/*.toml; do
        [ -f "$table" ] || continue
        if ! grep -q '^# read-from:' "$table"; then
            printf '%s has no read-from header naming where its rows came from\n' "$table"
            status=1
        fi
    done
    if git ls-files | grep -iE '\.(pkg|elf|prx|sprx|bin|self)$'; then
        printf 'material committed: real files are an oracle, not a source\n'
        status=1
    fi

    # Images are the only binaries tracked.
    tracked_binaries() {
        git ls-files | while IFS= read -r f; do
            case "$f" in *.png|*.ico|*.svg|*.jpg|*.gif|*.woff2) continue ;; esac
            [ -f "$f" ] || continue
            case "$(head -c 4 "$f" | od -An -tx1 | tr -d ' ')" in
                7f454c46*|4d5a*|cffaedfe*|cefaedfe*) printf '%s\n' "$f" ;;
            esac
        done
    }

    if tracked_binaries | grep .; then
        printf 'these are executables, whatever they are named\n'
        status=1
    fi
    return $status
}

# The three test targets that link a module fail here if any of them skipped for a missing
# `ld.lld`, since a skip verifies nothing about the linker scripts.
links() {
    local log="${TMPDIR:-/tmp}/selfish-links.$$"
    local target
    for target in links prospero module; do
        printf '=== %s\n' "$target"
        cargo test -p selfish-elf --test "$target" -- --nocapture 2>&1 | tee "$log"
        if grep -q 'skipped:' "$log"; then
            rm -f "$log"
            printf 'the %s tests skipped, so this proved nothing about the script\n' "$target" >&2
            return 1
        fi
    done
    rm -f "$log"
}

usage() {
    local last
    last=$(( $(grep -n '^set -euo pipefail$' "$0" | head -1 | cut -d: -f1) - 1 ))
    sed -n "2,${last}p" "$0" | sed 's/^# \{0,1\}//'
}

verb="${1:-check}"
[ "$#" -gt 0 ] && shift
case "$verb" in
    check) check ;;
    provenance) provenance ;;
    links) links ;;
    build) cargo build --release --workspace "$@" ;;
    test)  cargo test --workspace "$@" ;;
    lint)  cargo clippy --all-targets --all-features "$@" -- -D warnings ;;
    fmt)   cargo fmt --all "$@" ;;
    clean) cargo clean "$@" ;;
    doc)   RUSTDOCFLAGS="$DOC_FLAGS" cargo doc --no-deps --workspace "$@" ;;
    -h|--help|help) usage ;;
    *) printf 'unknown verb: %s (try ./bin/selfish --help)\n' "$verb" >&2; exit 1 ;;
esac
